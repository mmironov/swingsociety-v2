# Payload writes uploaded media here in local (filesystem) storage mode.
public/media

# NOTE: src/app/(payload)/admin/importMap.js is generated by
# `payload generate:importmap`, but it MUST be committed — the admin route group
# imports it in three places, so a checkout without it fails to compile with
# "Module not found: Can't resolve '../importMap.js'". It is also regenerated
# during `npm run build:production` so it cannot drift from the admin components.

