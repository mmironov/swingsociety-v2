# ─── Database ────────────────────────────────────────────────────────────────
# Local development: the Postgres started by `npm run db:up`.
# Production (Neon): copy the *pooled* connection string from the Neon dashboard,
# e.g. postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/swingsociety?sslmode=require
DATABASE_URI=postgresql://swingsociety:swingsociety@localhost:5433/swingsociety

# ─── Payload ─────────────────────────────────────────────────────────────────
# Signs auth tokens and preview cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this logs everyone out. Never commit the real value.
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# ─── URLs ────────────────────────────────────────────────────────────────────
# Public origin of the site. Used for canonical URLs, sitemap, og:image and
# the admin panel's "view page" links. No trailing slash.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Seeding (optional) ──────────────────────────────────────────────────────
# The first admin account `npm run seed` creates when the database is empty.
SEED_ADMIN_EMAIL=admin@swingsociety.bg
SEED_ADMIN_PASSWORD=changeme

# ─── File storage ────────────────────────────────────────────────────────────
# Vercel Blob. Set automatically when you create a Blob store in the Vercel
# dashboard and link it to the project.
#
# Leave this EMPTY locally: with no token the storage plugin turns itself off and
# uploads go to public/media on disk, which is what you want for development.
# In production it is required — Vercel's filesystem is ephemeral, so without it
# uploads fail and existing files vanish on the next deploy.
BLOB_READ_WRITE_TOKEN=

# ─── Email (optional, but needed for password resets) ────────────────────────
# Without a key Payload writes emails to the console, so a forgotten CMS password
# can only be reset from the command line. Get a key at resend.com.
RESEND_API_KEY=
# Resend refuses to send from an unverified domain. Until swingsociety.bg is
# verified, leave this empty and it falls back to Resend's onboarding sender,
# which only delivers to the Resend account owner — enough to prove the flow works.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
